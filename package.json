{
  "name": "cribl-lhe-performance",
  "version": "0.7.0",
  "type": "module",
  "displayName": "Cribl LHE Performance Lab",
  "description": "Run, compare, and review repeatable Lakehouse Engine time-window performance tests.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && apps build",
    "package": "apps package",
    "deploy": "cribl-app-deploy",
    "inspect:pack": "cribl-app-inspect",
    "release:evidence": "cribl-app-release-evidence",
    "security:static": "cribl-app-security",
    "lint": "eslint . --max-warnings=0",
    "verify": "npm run lint && npm test && tsc -b",
    "audit": "npm audit --omit=dev --audit-level=low && npm audit --audit-level=high",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@capra/core": "^1.15.0",
    "@criblio/app-utils": "^0.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@cribl/apps": "1.3.0",
    "@criblio/app-tooling": "^0.4.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "playwright-core": "^1.45.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "cribl": {
    "type": "app",
    "createAppScriptVersion": "1.1.0"
  }
}
